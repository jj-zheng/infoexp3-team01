{
  "name": "InfoExp3 MiniBoard",

  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {}
  },

  "forwardPorts": [
    5000
  ],

  "portsAttributes": {
    "5000": {
      "label": "MiniBoard",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "pip install -r requirements.txt"
}